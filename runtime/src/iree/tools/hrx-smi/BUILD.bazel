load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_binary")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# The curated text report is amdxdna-focused (and the amdxdna driver only builds
# on Linux and Windows), so hrx-smi follows suit. JSON output still walks the
# generic HAL driver registry for whichever drivers are linked in.
_HRX_SMI_COMPATIBLE_WITH = select({
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

iree_runtime_cc_binary(
    name = "hrx-smi",
    srcs = ["hrx-smi.c"],
    target_compatible_with = _HRX_SMI_COMPATIBLE_WITH,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers",
        "//runtime/src/iree/hal/drivers/amdxdna",
    ],
)
